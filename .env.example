# Copy to .env and fill in. .env is gitignored — never commit real keys.

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# Icecast source password (also set in liquidsoap/radio.liq's output.icecast call
# and in the icecast config the devShell generates). Pick any local password —
# this never leaves your machine.
ICECAST_SOURCE_PASSWORD=

# Local service ports (defaults shown; change only if they collide with something)
ENGINE_HTTP_PORT=7777
LIQUIDSOAP_TELNET_PORT=1234
ICECAST_PORT=8000
